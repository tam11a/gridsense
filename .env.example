# GridSense: copy to .env and fill in. Never commit .env.

# Public hostname. Point its DNS at this server for automatic HTTPS (Caddy).
# Use :80 for plain HTTP on a local machine.
GRIDSENSE_DOMAIN=gridsense.example.com

# Optional: also serve GridSense 1.x (legacy/) on its own hostname.
# Uncomment both lines (see docker-compose.legacy.yml).
# GRIDSENSE_LEGACY_DOMAIN=legacy.gridsense.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.legacy.yml

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=
JWT_EXPIRE=7d

# First admin account, created on first start (never overwritten afterwards).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional: comma-separated origins allowed to call the API cross-origin.
# Not needed when the dashboard and API share a domain behind the proxy.
CORS_ORIGINS=

# Optional broker credentials for the API (see infra/mosquitto/README.md).
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=1883
# Shown in the dashboard as the address devices should connect to.
PUBLIC_MQTT_URL=
