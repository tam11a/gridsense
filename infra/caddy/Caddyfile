# Single public entry point for GridSense.
#   /api/*  -> NestJS API (prefix stripped)
#   /mqtt   -> Mosquitto WebSockets (for the live dashboard)
#   /*      -> Next.js dashboard
#
# GRIDSENSE_DOMAIN=gridsense.example.com gets automatic HTTPS from Let's Encrypt
# (the domain's DNS must point at this server and ports 80/443 must be open).
# Leave it unset (":80") for plain HTTP on a local machine.

{$GRIDSENSE_DOMAIN::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:4000
	}

	# The broker never needs the dashboard's login cookie, and Mosquitto's
	# WebSocket listener stalls on handshakes with headers over ~4 KB.
	handle_path /mqtt* {
		reverse_proxy mqtt:9001 {
			header_up -Cookie
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# GridSense 1.x (iot-101) on its own hostname: legacy-api, legacy-web and the
# shared broker. Unset locally, it answers on legacy.localhost.
{$GRIDSENSE_LEGACY_DOMAIN:legacy.localhost} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy legacy-api:4000
	}

	# The 1.x dashboard uses mqtt.js 5.6.2, which drops the URL path, so its
	# WebSocket arrives at "/" rather than "/mqtt". Accept both.
	@mqtt_ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @mqtt_ws {
		reverse_proxy mqtt:9001 {
			header_up -Cookie
		}
	}

	handle {
		reverse_proxy legacy-web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
